# --- Existing ---
PORT=9000
Mongo_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/ams
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string

# --- Research Logs: Google Drive (OAuth) ---
# Get these from https://console.cloud.google.com/apis/credentials
# Add http://localhost:9000/api/auth/google/callback as an authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9000/api/auth/google/callback

# --- Research Logs: Google Gemini (free tier) ---
# Get the key at https://aistudio.google.com/apikey
# Must be from the same GCP project as the OAuth credentials above.
GEMINI_API_KEY=
# Swap to gemini-2.5-pro for higher quality (stricter rate limits).
GEMINI_MODEL=gemini-3-flash
# Optional override. Defaults to "gemini".
SUMMARY_PROVIDER=gemini

# Optional: override the frontend URL the OAuth callback redirects to.
# FRONTEND_URL=http://localhost:5173
